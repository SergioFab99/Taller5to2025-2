  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Recuperaci\xF3n de vida: Ahora cada vez que se reduzca la vida del jugador
    dentro de su barra de vida, se mostrar\xE1 el da\xF1o total que ha recibido de
    forma consecutiva mediante una barra de un color m\xE1s opaco y este contar\xE1
    como \u201Cda\xF1o recibido\u201D, si esta alcanza a llegar a 0, el jugador perder\xE1
    como lo hace regularmente. Esta barra extra solo se va reduciendo de uno en uno
    hasta alcanzar la vida actual del jugador pasado un periodo de 1 segundo despu\xE9s
    del da\xF1o consecutivo, si vuelve a recibir da\xF1o aun con la barra bajando,
    esta se detiene.\r\n\r\nSi el jugador realiza conexiones directas con un enemigo
    detiene la barra si es que est\xE1 bajando y el da\xF1o de estas se convierte
    en una suma a vida actual pudiendo alcanzar el m\xE1ximo de la barra de \u201Cda\xF1o
    recibido\u201D.\r\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
